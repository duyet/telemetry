{
	"compilerOptions": {
		"target": "es2024",
		"lib": [
			"es2024"
		],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": [
			"bun"
		],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx"
	},
	"include": [
		"src",
		"test",
		"scripts",
		"cloudflare.config.ts",
		".cloudflare/types"
	]
}
